{
  "version": 8,
  "description": "Server/client shared queue policy knobs for world-map preview/chunk control (EMA/hysteresis + distance-priority aware).",
  "server": {
    "maxQueuedChunkRequests": 3072,
    "queuePressureFactor": 3,
    "queueSlackRatio": 2.7,
    "queueBurstSlackMultiplier": 1.15,
    "queueLoadSheddingThreshold": 0.87,
    "queueEmergencyBrakeThreshold": 1.1,
    "queueOverloadDrainFactor": 3,
    "queueBackoffDelayMs": 7,
    "maxConcurrentChunkGenerations": 10,
    "updateBatchSize": 56,
    "updateIntervalMs": 100
  },
  "client": {
    "maxQueuedChunkRequests": 3072,
    "queuePressureFactor": 4,
    "queueSlackRatio": 2.35,
    "queueBurstSlackMultiplier": 1.15,
    "queueLoadSheddingThreshold": 0.85,
    "queueEmergencyBrakeThreshold": 1.06,
    "queueOverloadDrainFactor": 3,
    "queueBackoffDelayMs": 6,
    "maxLoadedPreviewChunks": 4096,
    "maxConcurrentChunkRequests": 8
  }
}
