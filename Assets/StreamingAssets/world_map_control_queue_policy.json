{
  "version": 5,
  "description": "Server/client shared queue policy knobs for world-map preview/chunk control.",
  "server": {
    "maxQueuedChunkRequests": 3072,
    "queuePressureFactor": 3,
    "queueSlackRatio": 2.6,
    "queueBurstSlackMultiplier": 1.15,
    "queueLoadSheddingThreshold": 0.88,
    "queueOverloadDrainFactor": 3,
    "queueBackoffDelayMs": 7,
    "maxConcurrentChunkGenerations": 10,
    "updateBatchSize": 56,
    "updateIntervalMs": 100
  },
  "client": {
    "maxQueuedChunkRequests": 3072,
    "queuePressureFactor": 4,
    "queueSlackRatio": 2.3,
    "queueBurstSlackMultiplier": 1.15,
    "queueLoadSheddingThreshold": 0.86,
    "queueOverloadDrainFactor": 3,
    "queueBackoffDelayMs": 6,
    "maxLoadedPreviewChunks": 4096,
    "maxConcurrentChunkRequests": 8
  }
}
