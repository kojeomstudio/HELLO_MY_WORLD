<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
<OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RollForward>Major</RollForward>
    <AssemblyName>GameServerLauncher</AssemblyName>
    <RootNamespace>GameServer.Launcher</RootNamespace>

    <!-- 런처 메타데이터 -->
    <Version>1.0.0</Version>
    <Authors>HELLO_MY_WORLD Team</Authors>
    <Description>게임 서버 런처 - 서버 실행, 관리, 모니터링</Description>
    <Product>HELLO_MY_WORLD Game Server Launcher</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- GameServer 프로젝트 참조 (핵심 로직) -->
    <ProjectReference Include="../GameServer/GameServer.csproj" />

    <!-- GameCommon 라이브러리 참조 -->
    <ProjectReference Include="../GameCommon/GameCommon.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 설정 파일 복사 -->
    <None Update="launcher-config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
