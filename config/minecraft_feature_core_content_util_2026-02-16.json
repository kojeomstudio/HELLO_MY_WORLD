{
  "version": "2026-02-16",
  "summary": "Flow-shadowed hydrology that keeps caves/rivers/lakes stitched across seams, hashed map-control parity, and stronger protobuf origin checks.",
  "core": [
    {
      "id": "core.hydrology_flow_shadow",
      "name": "Flow-shadow hydrology masks",
      "description": "Blend hydrology + flow shadows so caves, rivers, and lakes share stable, seam-safe masks.",
      "owners": [
        "GameServer/World/Generation",
        "Assets/Scripts/Minecraft/World",
        "MapGeneratorLib/MapGeneratorLib/Sources/Algorithms"
      ],
      "artifacts": [
        "GameServer/World/Generation/ImprovedTerrainCoordinator.cs",
        "GameServer/World/Generation/ImprovedRiverGenerator.cs",
        "GameServer/World/Generation/ImprovedLakeGenerator.cs",
        "Assets/Scripts/Minecraft/World/EnhancedTerrainGenerator.cs",
        "MapGeneratorLib/MapGeneratorLib/Sources/Algorithms/WorldGenAlgorithms.cs"
      ]
    },
    {
      "id": "core.worldmap_control",
      "name": "World-map control sync",
      "description": "Keep render/simulation/hydrology + enhanced-terrain knobs hashed across server JSON and Unity StreamingAssets with hot reload.",
      "owners": [
        "GameServer/World/WorldMapControlManager.cs",
        "Assets/MyAssets/Scripts/GameWorld/WorldMapControlProfile.cs",
        "Assets/StreamingAssets/config"
      ],
      "artifacts": [
        "config/world.json",
        "config/world_map_control_profile.json",
        "Assets/StreamingAssets/world-map-control.json",
        "Assets/StreamingAssets/enhanced-terrain-config.json",
        "Assets/StreamingAssets/world-config.json"
      ]
    },
    {
      "id": "core.protocol_guard",
      "name": "Protocol origin guard",
      "description": "Descriptor origin + fingerprint + parser coverage validation before handlers wire up.",
      "owners": [
        "SharedProtocol/EnhancedMinecraft/ProtocolStandardization.cs",
        "SharedProtocol/EnhancedMinecraft/ProtocolValidator.cs"
      ],
      "artifacts": [
        "SharedProtocol/EnhancedMinecraft/*",
        "Assets/Scripts/Networking/Core/ProtobufNetworkClient.cs",
        "proto/*.proto"
      ]
    }
  ],
  "content": [
