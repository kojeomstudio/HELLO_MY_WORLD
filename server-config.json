{
  "server": {
    "name": "Minecraft Server",
    "maxPlayers": 100,
    "port": 25565,
    "bindAddress": "0.0.0.0",
    "motd": "Welcome to the Minecraft Server!",
    "difficulty": "normal",
    "gamemode": "survival",
    " hardcore": false,
    "pvp": true,
    "allowFlight": false,
    "spawnProtection": true,
    "spawnProtectionRadius": 16,
    "viewDistance": 10,
    "simulationDistance": 8
  },
  "world": {
    "name": "world",
    "seed": null,
    "generator": {
      "type": "enhanced_terrain",
      "settings": {
        "chunkSize": 16,
        "subWorldSizeX": 64,
        "subWorldSizeY": 256,
        "subWorldSizeZ": 64,
        "globalWaterLevel": 62,
        "caveGeneration": {
          "enabled": true,
          "caveDensity": 0.1,
          "caveSize": 0.5,
          "caveDepth": 40,
          "caveHeight": 128
        },
        "riverGeneration": {
          "enabled": true,
          "riverWidth": 5,
          "riverDepth": 3,
          "riverFrequency": 0.05,
          "riverMeandering": 0.8
        },
        "lakeGeneration": {
          "enabled": true,
          "lakeFrequency": 0.02,
          "lakeSize": 0.3,
          "lakeDepth": 8,
          "deepLakeChance": 0.1
        },
        "terrainGeneration": {
          "heightScale": 684.412,
          "heightVariation": 17,
          "baseHeight": 64,
          "noiseScale": 0.025,
          "octaves": 4,
          "persistence": 0.5,
          "lacunarity": 2.0
        }
      }
    },
    "features": {
      "structures": {
        "villages": {
          "enabled": true,
          "spacing": 32,
          "separation": 8
        },
        "temples": {
          "enabled": true,
          "spacing": 32,
          "separation": 8
        },
        "mineshafts": {
          "enabled": true,
          "spacing": 1,
          "separation": 0
        }
      },
      "ores": {
        "coal": {
          "enabled": true,
          "veinSize": 16,
          "veinsPerChunk": 20,
          "minHeight": 0,
          "maxHeight": 128
        },
        "iron": {
          "enabled": true,
          "veinSize": 8,
          "veinsPerChunk": 20,
          "minHeight": 0,
          "maxHeight": 64
        },
        "gold": {
          "enabled": true,
          "veinSize": 8,
          "veinsPerChunk": 2,
          "minHeight": 0,
          "maxHeight": 32
        },
        "diamond": {
          "enabled": true,
          "veinSize": 7,
          "veinsPerChunk": 1,
          "minHeight": 0,
          "maxHeight": 16
        }
      }
    }
  },
  "gameplay": {
    "hunger": {
      "enabled": true,
      "depletionRate": 0.5,
      "starvationDamage": 1.0,
      "regenerationThreshold": 80.0
    },
    "health": {
      "maxHealth": 100.0,
      "regenerationRate": 1.0,
      "respawnHealth": 100.0
    },
    "experience": {
      "enabled": true,
      "dropOnDeath": true,
      "keepOnDeath": false
    },
    "inventory": {
      "hotbarSize": 9,
      "mainInventorySize": 27,
      "maxStackSize": 64
    },
    "crafting": {
      "enabled": true,
      "craftingSpeed": 1.0,
      "enableAllRecipes": true
    }
  },
  "network": {
    "compression": {
      "enabled": true,
      "threshold": 256
    },
    "encryption": {
      "enabled": false
    },
    "protocol": {
      "version": "1.0",
      "protobufEnabled": true
    },
    "timeouts": {
      "connectionTimeout": 30000,
      "readTimeout": 15000,
      "writeTimeout": 15000
    },
    "rateLimit": {
      "enabled": true,
      "maxPacketsPerSecond": 20,
      "maxBytesPerSecond": 32768
    }
  },
  "logging": {
    "level": "INFO",
    "console": {
      "enabled": true,
      "color": true
    },
    "file": {
      "enabled": true,
      "path": "logs/server.log",
      "maxSize": "10MB",
      "maxFiles": 5,
      "rotate": true
    },
    "categories": {
      "network": true,
      "world": true,
      "player": true,
      "combat": true,
      "inventory": true,
      "crafting": true,
      "errors": true
    }
  },
  "database": {
    "type": "sqlite",
    "connectionString": "Data Source=game.db;Version=3;",
    "backup": {
      "enabled": true,
      "interval": 3600,
      "path": "backups/",
      "maxBackups": 10
    },
    "migrations": {
      "autoApply": true,
      "path": "migrations/"
    }
  },
  "security": {
    "authentication": {
      "enabled": true,
      "requirePassword": true,
      "minPasswordLength": 6,
      "maxLoginAttempts": 5,
      "lockoutDuration": 300
    },
    "permissions": {
      "defaultGroup": "player",
      "groups": {
        "player": {
          "commands": ["help", "spawn", "msg", "list"],
          "permissions": ["build", "interact"]
        },
        "moderator": {
          "commands": ["kick", "ban", "tp", "gamemode"],
          "permissions": ["build", "interact", "moderate"]
        },
        "admin": {
          "commands": ["*"],
          "permissions": ["*"]
        }
      }
    },
    "antiCheat": {
      "enabled": true,
      "flyDetection": true,
      "speedDetection": true,
      "reachDetection": true,
      "blockReachDistance": 6.0
    }
  },
  "performance": {
    "ticks": {
      "targetTPS": 20,
      "maxTickTime": 50
    },
    "chunks": {
      "viewDistance": 10,
      "sendDistance": 8,
      "maxLoadedChunks": 1000,
      "chunkLoadInterval": 0.1
    },
    "entities": {
      "maxEntities": 500,
      "maxItems": 200,
      "maxMobs": 300,
      "activationDistance": 64
    },
    "gc": {
      "forceGCInterval": 600,
      "memoryThreshold": 0.8
    }
  }
